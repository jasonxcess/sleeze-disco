; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

_global_script_classes=[ {
"base": "Node2D",
"class": "FXManager",
"language": "GDScript",
"path": "res://scripts/fx/FXManager.gd"
}, {
"base": "Reference",
"class": "SheetFrames",
"language": "GDScript",
"path": "res://scripts/util/SheetFrames.gd"
} ]
_global_script_class_icons={
"FXManager": "",
"SheetFrames": ""
}

[application]

config/name="Sleeze Disco"
config/description="2.5D rhythm-action beat 'em up. Original game inspired by Dead as Disco — no assets, music or characters from that game."
run/main_scene="res://scenes/Main.tscn"
config/icon="res://assets/sprites/player_sprite.png"

[autoload]

RhythmManager="*res://scripts/managers/RhythmManager.gd"

[display]

window/size/width=960
window/size/height=544
window/size/resizable=false
window/stretch/mode="2d"
window/stretch/aspect="keep"

